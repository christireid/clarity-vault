// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ═══════════════════════════════════════════════════════════════════
// USER & AUTHENTICATION
// ═══════════════════════════════════════════════════════════════════

model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String    @unique
  name        String?
  avatarUrl   String?
  // Settings stored as JSON
  preferences Json      @default("{}")
  // Relations
  workspaces  WorkspaceMember[]
  prompts     Prompt[]
  executions  Execution[]
  evaluations Evaluation[]
  memories    Memory[]
  apiKeys     ApiKey[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clerkId])
  @@index([email])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  prefix     String    // First 8 chars for display (e.g., "pv_sk_xxx")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([key])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════
// WORKSPACE & TEAM
// ═══════════════════════════════════════════════════════════════════

model Workspace {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String?
  logoUrl          String?
  // Settings stored as JSON
  settings         Json             @default("{}")
  // Subscription info
  plan             WorkspacePlan    @default(FREE)
  stripeCustomerId String?
  // Relations
  members          WorkspaceMember[]
  prompts          Prompt[]
  collections      Collection[]
  executions       Execution[]
  evaluations      Evaluation[]
  memories         Memory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
}

enum WorkspacePlan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  role        MemberRole @default(MEMBER)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ═══════════════════════════════════════════════════════════════════
// PROMPTS & VERSION CONTROL
// ═══════════════════════════════════════════════════════════════════

model Prompt {
  id               String            @id @default(cuid())
  title            String
  description      String?
  category         PromptCategory    @default(OTHER)
  tags             String[]
  // Current version pointer
  currentVersionId String?           @unique
  currentVersion   PromptVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  // Metadata
  favorite         Boolean           @default(false)
  archived         Boolean           @default(false)
  public           Boolean           @default(false)
  usageCount       Int               @default(0)
  // Relations
  versions         PromptVersion[]   @relation("PromptVersions")
  contexts         Context[]
  executions       Execution[]
  evaluations      Evaluation[]
  collectionItems  CollectionItem[]
  // Ownership
  authorId         String
  author           User              @relation(fields: [authorId], references: [id])
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([workspaceId])
  @@index([authorId])
  @@index([category])
  @@index([tags])
  @@index([favorite])
  @@index([createdAt])
  @@index([usageCount])
}

enum PromptCategory {
  WRITING
  DEVELOPMENT
  ANALYSIS
  CREATIVE
  PRODUCTIVITY
  BUSINESS
  CUSTOMER_SERVICE
  EDUCATION
  OTHER
}

model PromptVersion {
  id            String          @id @default(cuid())
  version       Int             @default(1)
  content       String
  // Version control metadata
  commitMessage String?
  // Branching support
  parentId      String?
  parent        PromptVersion?  @relation("VersionHistory", fields: [parentId], references: [id])
  children      PromptVersion[] @relation("VersionHistory")
  // Branch name (null = main branch)
  branch        String?
  // Variables extracted from content (JSON array)
  variables     Json            @default("[]")
  // Computed metrics
  tokenCount    Int?
  // Relations
  prompt        Prompt          @relation("PromptVersions", fields: [promptId], references: [id], onDelete: Cascade)
  promptId      String
  // Reverse relation for currentVersion
  currentFor    Prompt?         @relation("CurrentVersion")
  // Executions on this version
  executions    Execution[]
  createdById   String
  createdAt     DateTime        @default(now())

  @@unique([promptId, version, branch])
  @@index([promptId])
  @@index([parentId])
  @@index([branch])
}

// ═══════════════════════════════════════════════════════════════════
// CONTEXT & ATTACHMENTS
// ═══════════════════════════════════════════════════════════════════

model Context {
  id        String      @id @default(cuid())
  name      String
  type      ContextType
  // Content based on type
  content   String?     // For notes, templates
  url       String?     // For links, files
  mimeType  String?     // For files
  fileSize  Int?        // For files (bytes)
  // Metadata stored as JSON
  metadata  Json        @default("{}")
  // Vector embedding for RAG (1536 dimensions for OpenAI ada-002)
  embedding Unsupported("vector(1536)")?
  promptId  String
  prompt    Prompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([promptId])
  @@index([type])
}

enum ContextType {
  FILE
  NOTE
  LINK
  TEMPLATE
  DOCUMENT
}

// ═══════════════════════════════════════════════════════════════════
// COLLECTIONS
// ═══════════════════════════════════════════════════════════════════

model Collection {
  id          String           @id @default(cuid())
  name        String
  description String?
  color       String?          // Hex color
  icon        String?          // Icon identifier
  items       CollectionItem[]
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  position     Int        @default(0)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  promptId     String
  prompt       Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, promptId])
  @@index([collectionId])
  @@index([promptId])
}

// ═══════════════════════════════════════════════════════════════════
// EXECUTIONS & LLM CALLS
// ═══════════════════════════════════════════════════════════════════

model Execution {
  id               String          @id @default(cuid())
  // Input/Output
  input            Json            // { variables: {...}, context: [...] }
  output           String?
  // LLM Details
  provider         LLMProvider
  model            String
  temperature      Float?
  maxTokens        Int?
  // Metrics
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  cost             Float?
  // Status
  status           ExecutionStatus @default(PENDING)
  error            String?
  // Relations
  promptId         String
  prompt           Prompt          @relation(fields: [promptId], references: [id], onDelete: Cascade)
  versionId        String?
  version          PromptVersion?  @relation(fields: [versionId], references: [id])
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evaluations      Evaluation[]
  createdAt        DateTime        @default(now())
  completedAt      DateTime?

  @@index([promptId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum LLMProvider {
  OPENAI
  ANTHROPIC
  COHERE
  GOOGLE
  AZURE
  CUSTOM
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════════
// EVALUATIONS
// ═══════════════════════════════════════════════════════════════════

model Evaluation {
  id             String         @id @default(cuid())
  // Evaluation type
  type           EvaluationType
  // Scores (0-1 range)
  score          Float
  // Criteria evaluated (array of strings)
  criteria       String[]
  // Detailed results as JSON
  results        Json           // { criteria1: score, criteria2: score, ... }
  // Feedback
  feedback       String?
  reasoning      String?        // For LLM-as-judge
  // Source
  evaluatorType  EvaluatorType
  evaluatorModel String?        // If LLM-as-judge
  // Relations
  executionId    String?
  execution      Execution?     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  promptId       String?
  prompt         Prompt?        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([promptId])
  @@index([executionId])
  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

enum EvaluationType {
  CORRECTNESS
  RELEVANCY
  FAITHFULNESS
  COHERENCE
  TOXICITY
  CUSTOM
}

enum EvaluatorType {
  LLM_JUDGE
  HUMAN
  AUTOMATED // Rule-based
}

// ═══════════════════════════════════════════════════════════════════
// MEMORY MANAGEMENT
// ═══════════════════════════════════════════════════════════════════

model Memory {
  id           String       @id @default(cuid())
  // Memory classification
  type         MemoryType
  scope        MemoryScope
  // Content
  content      String
  summary      String?      // Condensed version
  // Importance scoring (like Mem0)
  importance   Float        @default(0.5)
  accessCount  Int          @default(0)
  lastAccessed DateTime?
  // Vector embedding for semantic retrieval
  embedding    Unsupported("vector(1536)")?
  // Metadata as JSON
  metadata     Json         @default("{}")
  // Relations
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Session tracking
  sessionId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  expiresAt    DateTime?

  @@index([userId])
  @@index([workspaceId])
  @@index([type])
  @@index([scope])
  @@index([sessionId])
  @@index([importance])
}

enum MemoryType {
  FACT       // Factual information
  PREFERENCE // User preferences
  CONTEXT    // Contextual information
  CONVERSATION // Conversation history
  FEEDBACK   // User feedback
}

enum MemoryScope {
  USER      // Specific to a user
  SESSION   // Specific to a session
  WORKSPACE // Workspace-wide
  GLOBAL    // Cross-workspace
}
